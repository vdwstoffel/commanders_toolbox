# Copy this file to secrets.properties and fill in real values.

# JWT authentication (secret MUST be at least 32 bytes for HS256)
app.jwt.secret=replace-with-a-random-string-at-least-32-bytes-long
app.jwt.ttl-seconds=604800

# Database configuration
spring.datasource.url=jdbc:postgresql://database:5432/mtgApp
spring.datasource.username=your-db-user
spring.datasource.password=your-db-password
spring.jpa.hibernate.ddl-auto=update
